<?xml version="1.0" encoding="utf-8"?>
<strings>
    <language name="en">
        <string name="ok">OK</string>
        <string name="close">Close</string>
        <string name="buy">Buy</string>
        <string name="retry">Retry</string>
        <string name="cancel">Cancel</string>
        <!-- Connection Error dialog title -->
        <string name="connection_error_title">Connection Error!</string>
        <string name="connection_error_message">Unable to connect to server to establish the status of your purchase.</string>
        <!-- UIDialogText-ConnectionErrorRetry  -->
        <string name="connection_error_retry">Unable to connect, please make sure you are connected to the internet and try again.</string>
        <!-- UIDialogText-NoBillOption -->
        <string name="no_bill_option">No bill options available.</string>
        <!-- UIDialogText-UnableToProcessBill -->
        <string name="unable_to_process_billing">Unable to process billing.</string>
        <!-- PurchaseSuccess: should display RightsCheck() response element (from EA Smartphone DRM Client Specification draft.docx) -->
        <string name="purchase_success">Your purchase has been successful.</string>
        <!-- PurchaseFailure: should display AuthenticatePurchase() response element -->
        <string name="purchase_failure">Your purchase has failed. You have not been charged.</string>
        <!-- PendingPayment: should display AuthenticatePurchase() response element -->
        <string name="pending_payment">Waiting for confirmation of purchase, please don't leave this screen.</string>
        <!-- Progress Dialog that appears on first startup of SDK -->
        <string name="connecting_to_billing_server">Connecting...</string>
        <!-- if DisplayText tag does not exist in ServerActivate response. AcceptPurchase: has no pre-defined string; comes from ServerActivate() response (from EA Smartphone DRM Client Specification draft.docx) -->
        <string name="billing_options_description">Click buy to confirm purchase.</string>
        <string name="terms_and_conditions">T&amp;C</string>
        <!-- Appears on loading of webview -->
        <string name="loading">Loading...</string>
        <!-- Appears after the user presses on buy until payment is processed -->
        <string name="processing_payment">Processing Payment, please wait...</string>
        <!-- Appears as a toast when the billing SMS is sent successfully -->
        <string name="sms_sent">SMS Sent</string>
        <!-- Appears as a toast when the billing SMS is NOT sent successfully -->
        <string name="sms_not_sent">SMS not sent</string>
        <!-- Display Text for screen when user has been processing for more than a minute as in Figure 4 -->
        <string name="still_processing">Your purchase still processing. We're waiting for confirmation of the result from your provider.</string>
        <!-- Button text that appears when Processing is more than 1 minute as in Figure 4-->
        <string name="back_to_game">Back to Game</string>
        <!-- Button text that appears when Processing is more than 1 minute as in Figure 4-->
        <string name="wait_more">Continue Processing</string>
        <!-- A warning screen that appears to user when they are about to start a new transaction for a processing item as in Figure 5 -->
        <string name="previous_transaction_still_processing">Your Previous transaction is still processing. Do you want
            to add to Credit Card?
        </string>
        <!-- Appears to user when billing fails and there is another type of billing to try as in Figure 7-->
        <string name="billing_failed_continue">Unfortunately your previous transaction has failed. Would you like to try
            another billing?
        </string>
        <!-- Button text if there is more than one bill option -->
        <string name="next_bill_option">Next Option</string>
        <!-- Message that appears when an unhandled exception occurs on the client -->
        <string name="unexpected_error">Sorry an unexpected error occurred!</string>
        <!-- Message that appears when an unhandled exception occurs in Authenticate Purchase Pending Dialog -->
        <string name="authenticate_purchase_error">Sorry an unexpected error occurred. Please try again later.</string>
 		<string name="continue_button">Continue</string>
    </language>
    <language name="fr">
        <string name="ok">OK</string>
        <string name="close">Fermer</string>
        <string name="buy">Acheter</string>
        <string name="retry">Réessayer</string>
        <string name="cancel">Annuler</string>
        <string name="continue_button">Continuer</string>
        <string name="connection_error_title">Connection Error!</string>
        <string name="connection_error_message">Impossible de connecter au serveur afin de vérifier l'avancement de votre requête. Merci de vérifier que vous êtes bien connecté à Internet.</string>
        <string name="connection_error_retry">Impossible de se connecter. Vérifiez votre connexion Internet et réessayez.</string>
        <string name="no_bill_option">Nous ne sommes pas en mesure de vous facturer pour le moment. Réessayez ultérieurement.</string>
        <string name="unable_to_process_billing">Impossible d'effectuer la facturation</string>
        <string name="purchase_success">Votre achat s'est déroulé correctement.</string>
        <string name="purchase_failure">Votre achat a échoué. Rien ne vous a été facturé.</string>
        <string name="pending_payment">Attente de confirmation de l'achat. Ne quittez pas cet écran.</string>
        <string name="connecting_to_billing_server">Connexion...</string>
        <string name="billing_options_description">Cliquez "Acheter" pour confirmer l'achat.</string>
        <string name="terms_and_conditions">CG</string>
        <string name="loading">Chargement...</string>
        <string name="processing_payment">Paiement en cours. Veuillez patienter...</string>
        <string name="sms_sent">SMS envoyé</string>
        <string name="sms_not_sent">SMS non envoyé</string>
        <string name="still_processing">Achat toujours en cours de traitement. Nous attendons la confirmation de votre opérateur.</string>
        <string name="back_to_game">Retour au jeu</string>
        <string name="wait_more">Suite transaction</string>
        <string name="previous_transaction_still_processing">Your Previous transaction is still processing. Do you want to add to Credit Card?</string>
        <string name="billing_failed_continue">Unfortunately your previous transaction has failed. Would you like to try another billing?</string>
        <string name="next_bill_option">Autre option</string>
        <string name="unexpected_error">Excusez-nous, une erreur inattendue s'est produite!</string>
        <string name="authenticate_purchase_error">Excusez-nous, une erreur inattendue s'est produite. Réessayez ultérieurement.</string>
    </language>
    <language name="it">
        <string name="ok">OK</string>
        <string name="close">Chiudi</string>
        <string name="buy">Compra</string>
        <string name="retry">Riprova</string>
        <string name="cancel">Cancella</string>
         <string name="continue_button">Continua</string>
        <string name="connection_error_title">Connection Error!</string>
        <string name="connection_error_message">Impossibile connettersi al server per determinare lo status del tuo acquisto.</string>
        <string name="connection_error_retry">Impossibile connettersi. Assicurati di essere collegato a Internet e riprova.</string>
        <string name="no_bill_option">Impossibile fatturare in questo momento. Riprova più tardi.</string>
        <string name="unable_to_process_billing">Impossibile effettuare il pagamento.</string>
        <string name="purchase_success">Acquisto riuscito.</string>
        <string name="purchase_failure">Acquisto non riuscito. Non hai ricevuto addebiti.</string>
        <string name="pending_payment">In attesa di conferma dell'acquisto, non abbandonare questa schermata</string>
        <string name="connecting_to_billing_server">Connessione...</string>
        <string name="billing_options_description">Clicca Compra per confermare l'acquisto.</string>
        <string name="terms_and_conditions">T&amp;C</string>
        <string name="loading">Caricamento...</string>
        <string name="processing_payment">Elaborazione pagamento, attendi...</string>
        <string name="sms_sent">SMS inviato</string>
        <string name="sms_not_sent">SMS non inviato</string>
        <string name="still_processing">Stiamo ancora processando il tuo acquisto. Siamo in attesa di una conferma del risultato dal tuo provider</string>
        <string name="back_to_game">Continua elaborazione</string>
        <string name="wait_more">Continua elaborazione</string>
        <string name="previous_transaction_still_processing">Your Previous transaction is still processing. Do you want to add to Credit Card?</string>
        <string name="billing_failed_continue">Unfortunately your previous transaction has failed. Would you like to try another billing?</string>
        <string name="next_bill_option">Prossima opzione</string>
        <string name="unexpected_error">Spiacenti, si è verificato un errore inaspettato!</string>
         <string name="authenticate_purchase_error">Spiacenti, si è verificato un errore inaspettato. Riprova più tardi.</string>
    </language>
	<language name="de">
        <string name="ok">OK</string>
        <string name="close">schließen</string>
        <string name="buy">Kaufen</string>
        <string name="retry">Wiederholen</string>
        <string name="cancel">Abbrechen</string>
        <string name="continue_button">Fortfahren</string>
        <string name="connection_error_title">Connection Error!</string>
        <string name="connection_error_message">Verbindung zum Server zwecks Statusbestätigung deines Kaufs nicht möglich. </string>
        <string name="connection_error_retry">Verbindung nicht möglich. Bitte stelle sicher, dass du mit dem Internet verbunden bist, und versuche es noch einmal.</string>
        <string name="no_bill_option">Abrechnung derzeit nicht möglich. Bitte später erneut versuchen.</string>
        <string name="unable_to_process_billing">Bezahlung nicht möglich.</string>
        <string name="purchase_success">Dein Kauf war erfolgreich.</string>
        <string name="purchase_failure">Dein Kauf ist fehlgeschlagen. Es erfolgt keine Berechnung.</string>
        <string name="pending_payment">Warten auf Bestätigung des Kaufs, bitte diesen Bildschirm nicht verlassen</string>
        <string name="connecting_to_billing_server">Verbindungsaufbau...</string>
        <string name="billing_options_description">klicken Sie kaufen, um Ihren Kauf zu bestätigen</string>
        <string name="terms_and_conditions">AGB</string>
        <string name="loading">Lädt...</string>
        <string name="processing_payment">Zahlung wird verarbeitet, bitte warten...</string>
        <string name="sms_sent">SMS gesendet</string>
        <string name="sms_not_sent">SMS nicht gesendet</string>
        <string name="still_processing">Dein Kauf wird noch bearbeitet. Warten auf Bestätigung des Ergebnisses von deinem Provider</string>
        <string name="back_to_game">Zurück zum Spiel</string>
        <string name="wait_more">Vorgang fortsetzen</string>
        <string name="previous_transaction_still_processing">Your Previous transaction is still processing. Do you want to add to Credit Card?</string>
        <string name="billing_failed_continue">Unfortunately your previous transaction has failed. Would you like to try another billing?</string>
        <string name="next_bill_option">Nächste Option</string>
        <string name="unexpected_error">Es tut uns leid, ein unerwarteter Fehler ist aufgetreten!</string>
         <string name="authenticate_purchase_error">Es tut uns leid, ein unerwarteter Fehler ist aufgetreten. Bitte später erneut versuchen.</string>
    </language>
