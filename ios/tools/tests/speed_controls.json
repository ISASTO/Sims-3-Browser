  {
    "eval": "window.speedSnapshot=()=>{const d=sims3Test.memory(),app=d.getUint32(0x2c2424,true),sim=d.getUint32(app+0x5b4,true);return {minutes:d.getInt32(sim+0x78c,true),time:sims3Speed.time,wall:sims3Test.wallTime(),active:sims3Speed.active,blocked:sims3Speed.blocked,muted:sims3Speed.audioMuted,steps:sims3Speed.steps,limited:sims3Speed.limited,chunks:[...sims3AudioStreams.values()].map(s=>({running:s.running,chunks:s.chunks.length,queued:s.queued,base:s.base,nodes:s.chunks.filter(c=>c.node).length,buffers:s.chunks.filter(c=>c.b).length}))};};window.speedSamples=[];speedSnapshot()"
  },
  {
    "eval": "window.savedSpeedState=(()=>{const d=sims3Test.memory(),app=d.getUint32(0x2c2424,true),sim=d.getUint32(app+0x5b4,true);return {money:d.getInt32(sim+0x790,true),packs:d.getUint32(0x2c2570+0x2c,true),bonus:d.getUint8(app+0x55c),clock:speedSnapshot()};})();savedSpeedState"
  },
