      "down",
      400,
      120
    ],
    "right": true
  },
  {
    "frames": 12
  },
  {
    "assert": "Math.abs((speedSnapshot().time-pointerSpeedBefore.time)/(speedSnapshot().wall-pointerSpeedBefore.wall)-1)<.0001 && sims3Speed.blocked"
  },
