    "pointer": [
      "up"
    ],
    "right": true
  },
  {
    "frames": 90
  },
  {
    "eval": "window.heldTrace=sims3Test.takeInputTrace();heldTrace"
  },
  {
    "assert": "[1000001,1000002].every(id=>heldTrace.some(e=>e.id===id&&e.type===0)&&heldTrace.some(e=>e.id===id&&e.type===2))"
  },
