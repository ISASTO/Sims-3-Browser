    "eval": "window.controlState = () => {\n const d=sims3Test.memory(), app=d.getUint32(0x2c2424,true), sceneId=d.getUint32(app+0x4f8,true), scene=sceneId===2?d.getUint32(app+0x48,true):0, sim=d.getUint32(app+0x5b4,true), world=scene?d.getUint32(scene+0x2c,true):0;\n const packs=d.getUint32(0x2c2570+0x2c,true), entries=d.getUint32(0x2c2570+0x30,true);\n return {sceneId,state:scene?d.getUint32(scene+0x1ec,true):null,pause:scene?d.getUint8(scene+0x680):null,context:scene?d.getUint8(scene+0x636):null,angle:world?d.getFloat32(world+0x488,true):null,zoom:sims3Test.zoomBar(),money:sim?d.getInt32(sim+0x790,true):null,packs,packIds:Array.from({length:packs},(_,i)=>d.getInt32(d.getUint32(entries+4*i,true)+8,true)).sort((a,b)=>a-b),bonus:d.getUint8(app+0x55c),achievements:sim?d.getUint32(sim+0x7f8,true):null,goals:Array.from(new Uint32Array(d.buffer,app+0x560,16))};\n}; controlState()"
